# Groq API Key (for whisper-large-v3 Speech-to-Text)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API Key (for Gemini 2.5 / 1.5 Flash Fact-Checking & Editorial Adaptation)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Vercel Blob Token (for direct client uploads up to 500MB on Vercel)
# Automatically provided in Vercel project settings when Blob store is created:
BLOB_READ_WRITE_TOKEN=
